# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas / Local Connection
# Replace with your MongoDB Atlas connection string when ready:
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/banashankari?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/banashankari

# JWT Authentication
JWT_ACCESS_SECRET=banashankari_access_jwt_secret_dev_key_change_in_prod
JWT_REFRESH_SECRET=banashankari_refresh_jwt_secret_dev_key_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Initial Admin Bootstrap Credentials
INITIAL_ADMIN_EMAIL=admin@banashankarienterprises.com
INITIAL_ADMIN_PASSWORD=Admin@Bana2025Secure
INITIAL_ADMIN_NAME="Ramesh S H (Admin)"
INITIAL_ADMIN_PHONE="+91 997 253 6991"

# Optional Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
